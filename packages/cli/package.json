{
  "name": "@opentscad/cli",
  "version": "0.1.0",
  "description": "Command line interface for OpenTSCAD - TypeScript-based 3D CAD modeling with multi-repository support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opentscad": "./bin/opentscad.js",
    "opentscad-cli": "./bin/opentscad.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:bin",
    "build:bin": "node scripts/prepare-bin.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist bin",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "opentscad",
    "cad", 
    "3d-modeling",
    "typescript",
    "cli",
    "parametric-modeling",
    "opencascade",
    "multi-repository",
    "live-coding",
    "hot-reload"
  ],
  "author": {
    "name": "OpenTSCAD Team",
    "email": "team@opentscad.dev",
    "url": "https://opentscad.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "dependencies": {
    "commander": "^12.0.0",
    "chokidar": "^3.6.0",
    "ws": "^8.17.1",
    "esbuild": "^0.20.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.15",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@types/node": "^20.11.30",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.4.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "prettier": "^3.2.5"
  },
  "peerDependencies": {
    "@opentscad/core": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@opentscad/core": {
      "optional": true
    }
  },
  "files": [
    "dist/**/*",
    "bin/**/*", 
    "templates/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/opentscad.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/your-org/opentscad/issues"
  },
  "homepage": "https://opentscad.dev",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/opentscad"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}