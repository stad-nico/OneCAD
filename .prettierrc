{
  "singleQuote": true,
  "trailingComma": "es5",
  "useTabs": true,
  "tabWidth": 4,
  "printWidth": 120,
  "singleAttributePerLine": true,
  "bracketSameLine": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "parser": "angular"
      }
    }
  ]
}
