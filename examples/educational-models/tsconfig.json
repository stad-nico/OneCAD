{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@controls/*": ["./src/controls/*"],
      "@animations/*": ["./src/animations/*"],
      "@lessons/*": ["./lessons/*"]
    }
  },
  "include": ["models/**/*", "src/**/*", "lessons/**/*"],
  "exclude": ["node_modules", "dist"]
}